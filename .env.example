# PostgreSQL connection URLs
DATABASE_URL="postgresql://user:password@host-pooler.region.neon.tech/diyaverse?sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.neon.tech/diyaverse?sslmode=require"

# Canonical URL (Set to https://diyaverse.vercel.app in Vercel Production Environment Variables)
NEXT_PUBLIC_SITE_URL="https://diyaverse.vercel.app"

# Security Secrets (Generate with openssl rand -hex 32)
SESSION_SECRET="replace-with-at-least-32-chars-random-string"
IP_HASH_SALT="replace-with-salt-for-daily-rate-limiting"
CRON_SECRET="replace-with-cron-secret-for-scheduled-tasks"

# Admin Seed
ADMIN_SEED_EMAIL="shreyashsr2004@gmail.com"

# Analytics & Flags
ANALYTICS_RETENTION_DAYS=90
NEXT_PUBLIC_ENABLE_CONSENT_BANNER=true

# Optional Sentry
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
